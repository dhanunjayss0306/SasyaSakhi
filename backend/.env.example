# Copy to .env and fill in. Never commit real keys.
# Frontend origin(s) allowed to call this API (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Max soil-report upload size in MB.
MAX_UPLOAD_MB=10

# Optional: AI explanation provider (OpenAI-compatible chat-completions API).
# Leave blank to use the built-in deterministic template explanations.
# You create the key yourself on the provider's site; only paste it into .env,
# never into this file. Active lines below are for an OpenAI key.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Free alternative: a Google AI Studio key (Gemini). If you use that instead,
# swap the two lines above for these:
# AI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-2.5-flash

# Optional: Sarvam voice key (speech-to-text). Paste your key into .env only.
SARVAM_API_KEY=

# Optional: full path to the Tesseract binary (Windows example below).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Optional: override the data directory.
# DATA_DIR=./data
