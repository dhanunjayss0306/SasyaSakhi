# Copy to .env and fill in. Never commit real keys.
# Frontend origin(s) allowed to call this API (comma-separated).
CORS_ORIGINS=http://localhost:3000

# Max soil-report upload size in MB.
MAX_UPLOAD_MB=10

# Optional: AI explanation provider (OpenAI-compatible chat-completions API).
# Leave blank to use the built-in deterministic template explanations.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional: full path to the Tesseract binary (Windows example below).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Optional: override the data directory.
# DATA_DIR=./data
